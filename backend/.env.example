NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:troque_esta_senha@localhost:5432/licitagestao?schema=public
JWT_SECRET=gere_uma_chave_longa_e_aleatoria
JWT_REFRESH_SECRET=gere_outra_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=troque_esta_senha
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# Integração MEGA (configure no Render; nunca envie a senha ao GitHub)
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_ROOT_FOLDER=RB
MEGA_TENDERS_FOLDER=LICITAÇÕES

# Integração Gmail por empresa (Google OAuth 2.0 + Gmail API)
# A senha do Gmail nunca é usada pelo sistema.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/integrations/gmail/callback
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GOOGLE_OAUTH_STATE_SECRET=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Entre 60000 e 120000 ms. Padrão recomendado: 90 segundos.
GMAIL_POLL_INTERVAL_MS=90000

# Integração Outlook/Hotmail por empresa (Microsoft OAuth 2.0 + Graph)
# A senha da conta Microsoft nunca é usada pelo sistema.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3333/api/integrations/outlook/callback
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MICROSOFT_OAUTH_STATE_SECRET=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MICROSOFT_TOKEN_ENCRYPTION_KEY=
# Entre 60000 e 900000 ms. Padrão recomendado: 120 segundos.
OUTLOOK_POLL_INTERVAL_MS=120000
