NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:troque_esta_senha@localhost:5432/licitagestao?schema=public
JWT_SECRET=gere_uma_chave_longa_e_aleatoria
JWT_REFRESH_SECRET=gere_outra_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRES_IN=15m
ORGANIZATION_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# Recuperação da senha principal da organização via e-mail transacional.
RESEND_API_KEY=
PASSWORD_RESET_FROM=LicitaGestão <no-reply@seu-dominio.com>

# MEGA legado: mantido apenas para abrir documentos antigos que ainda não possuem dono individual.
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_ROOT_FOLDER=
MEGA_TENDERS_FOLDER=LICITAÇÕES
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEGA_CREDENTIAL_ENCRYPTION_KEY=

# Gmail por empresa gerenciada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/integrations/gmail/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GMAIL_POLL_INTERVAL_MS=90000

# Outlook/Hotmail por empresa gerenciada.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3333/api/integrations/outlook/callback
MICROSOFT_OAUTH_STATE_SECRET=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
OUTLOOK_POLL_INTERVAL_MS=120000
